# ==========================================
# SISTEMA DE COBRANÇA AUTOMÁTICA VIA WHATSAPP
# CONFIGURAÇÃO DE AMBIENTE (.env)
# ==========================================

# Porta de acesso externo da aplicação web (ex: http://IP_DA_VPS:3000)
APP_PORT=3000

# Credenciais de acesso inicial do Administrador
ADMIN_EMAIL=admin@cobranca.com
ADMIN_PASSWORD=Admin@Seguro2026!

# Chave secreta para geração dos tokens JWT (gere uma chave forte e aleatória)
JWT_SECRET=super_secreto_chave_jwt_cobranca_whatsapp_2026_mude_em_producao

# Configuração do Banco de Dados PostgreSQL
DB_USER=cobranca_user
DB_PASSWORD=senha_super_forte_postgres_2026
DB_NAME=cobrancadb

# Chave Global de Autenticação da Evolution API (gere uma chave segura)
EVOLUTION_API_KEY=evol_key_global_cobranca_segura_2026_whatsapp

# Configurações do Fuso Horário
TZ=America/Sao_Paulo
